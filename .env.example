# Base URL of the API. Paths in the code do not include "/api", so it must end with "/api".
# Keep "/api" (same origin): `npm run dev` proxies each /api prefix to its service port
# (see vite.config.ts) and the production nginx proxies /api to the gateway, so no CORS.
VITE_API_URL=/api

# Dev only: host where the backend services listen (ports 8081-8092). Default localhost.
# DEV_BACKEND_HOST=localhost

# Google sign-in (customers). OAuth 2.0 "Web application" client ID from Google Cloud Console; add the
# web origin (http://localhost:5173 for dev) to "Authorized JavaScript origins". It must be the same client
# the backend verifies against (auth-service AUTH_GOOGLE_CLIENT_ID). Leave empty to hide the Google button.
# VITE_GOOGLE_CLIENT_ID=
